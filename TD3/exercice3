#include<stdio.h>
#include<stdlib.h>

/* Structure d'un nœud de liste chaînée */
typedef struct liste {
    int val;
    struct liste *suivant;
} LISTE;

/* Supprime la première occurrence de la valeur minimale dans la liste */
/* Retourne 1 si suppression réussie, 0 si liste vide */
int SuppressionValeurMin(LISTE **L) {
    LISTE *ptr = *L, *pMin = NULL, *pPrec = NULL;
    int minim;
    
    /* Cas 1 : liste vide */
    if (!ptr)
        return 0;
    
    /* Cas 2 : taille de liste = 1 */
    else if (!ptr->suivant) {
        *L = NULL;
        free(ptr);
        return 1;
    }
    
    /* Initialisation avec la première valeur */
    minim = ptr->val;
    pMin = NULL;
    
    /* Chercher le minimum et sa position dans la liste */
    while (ptr->suivant) {
        if (minim > ptr->suivant->val) {
            minim = ptr->suivant->val;
            pMin = ptr;  /* pMin pointe vers le nœud précédant le minimum */
        }
        ptr = ptr->suivant;
    }
    
    /* Cas 3 : le minimum est en tête de liste (pMin == NULL) */
    if (!pMin) {
        ptr = *L;
        *L = (*L)->suivant;
        free(ptr);
        return 1;
    }
    
    /* Cas 4 : le minimum est ailleurs dans la liste */
    else {
        ptr = pMin->suivant;           /* ptr pointe vers le nœud à supprimer */
        pMin->suivant = pMin->suivant->suivant;  /* contourner le nœud */
        free(ptr);                     /* libérer la mémoire */
        return 1;
    }
}

/* Fonction pour insérer un élément à la fin de la liste */
void InsererElementEnFin(LISTE **head, int valeur) {
    LISTE *nouveau = (LISTE*)malloc(sizeof(LISTE));
    if (nouveau == NULL) {
        printf("Erreur d'allocation mémoire\n");
        exit(1);
    }
    nouveau->val = valeur;
    nouveau->suivant = NULL;
    
    if (*head == NULL) {
        *head = nouveau;
        return;
    }
    
    LISTE *courant = *head;
    while (courant->suivant != NULL) {
        courant = courant->suivant;
    }
    courant->suivant = nouveau;
}

/* Fonction pour afficher la liste */
void AfficherListe(LISTE *L) {
    if (L == NULL) {
        printf("Liste vide\n");
        return;
    }
    
    LISTE *courant = L;
    while (courant != NULL) {
        printf("%d -> ", courant->val);
        courant = courant->suivant;
    }
    printf("NULL\n");
}

/* Fonction pour libérer la mémoire de la liste */
void LibererListe(LISTE **L) {
    LISTE *courant = *L;
    LISTE *suivant;
    
    while (courant != NULL) {
        suivant = courant->suivant;
        free(courant);
        courant = suivant;
    }
    *L = NULL;
}

/* Fonction principale pour tester */
int main() {
    LISTE *L = NULL;
    
    /* Test 1 : Liste avec plusieurs éléments */
    printf("=== TEST 1 : Liste normale ===\n");
    InsererElementEnFin(&L, 5);
    InsererElementEnFin(&L, 2);
    InsererElementEnFin(&L, 8);
    InsererElementEnFin(&L, 1);
    InsererElementEnFin(&L, 4);
    
    printf("Liste originale : ");
    AfficherListe(L);
    
    SuppressionValeurMin(&L);
    printf("Après suppression du minimum (1) : ");
    AfficherListe(L);
    
    LibererListe(&L);
    
    /* Test 2 : Minimum en tête */
    printf("\n=== TEST 2 : Minimum en tête ===\n");
    InsererElementEnFin(&L, 1);
    InsererElementEnFin(&L, 3);
    InsererElementEnFin(&L, 5);
    InsererElementEnFin(&L, 7);
    
    printf("Liste originale : ");
    AfficherListe(L);
    
    SuppressionValeurMin(&L);
    printf("Après suppression du minimum (1) : ");
    AfficherListe(L);
    
    LibererListe(&L);
    
    /* Test 3 : Liste avec un seul élément */
    printf("\n=== TEST 3 : Liste avec un seul élément ===\n");
    InsererElementEnFin(&L, 10);
    
    printf("Liste originale : ");
    AfficherListe(L);
    
    SuppressionValeurMin(&L);
    printf("Après suppression : ");
    AfficherListe(L);
    
    LibererListe(&L);
    
    /* Test 4 : Liste vide */
    printf("\n=== TEST 4 : Liste vide ===\n");
    printf("Liste originale : ");
    AfficherListe(L);
    
    int resultat = SuppressionValeurMin(&L);
    printf("Résultat de suppression : %d (0 = échec)\n", resultat);
    
    return 0;
}
