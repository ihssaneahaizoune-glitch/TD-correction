/* DestructionListe : libère toute la mémoire allouée pour une liste chaînée */
void DestructionListe(LISTE **L) 
{
    LISTE *courant = *L;
    LISTE *suivant;
    
    /* Parcourir toute la liste et libérer chaque nœud */
    while (courant != NULL) {
        suivant = courant->next;  /* sauvegarder l'adresse du nœud suivant */
        free(courant);             /* libérer le nœud courant */
        courant = suivant;         /* passer au nœud suivant */
    }
    
    /* Mettre le pointeur de tête à NULL */
    *L = NULL;
}
